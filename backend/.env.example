# Environment variables for Chef Fergany Backend
NODE_ENV=production
PORT=5000

# PostgreSQL Connection String (replace with your Hostinger VPS PostgreSQL credentials)
DATABASE_URL=postgresql://chef_user:SuperStrongPassword2026@localhost:5432/chef_fergany

# JWT Secret Key
JWT_SECRET=cheffergany_super_secure_jwt_secret_token_change_in_production_2026!
JWT_EXPIRES_IN=30d

# Frontend URL (for CORS allowance)
FRONTEND_URL=https://newchef-azure.vercel.app

# Directory where uploaded dish photos are stored on Hostinger VPS
UPLOAD_PATH=/var/www/chef-fergany/uploads
MAX_FILE_SIZE_MB=5
